<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/solis_widget_action"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EC"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/solis_widget_title"
        android:text="SOLIS · TODAY"
        android:textColor="#9A5B00"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/solis_widget_task"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:text="No tasks planned yet"
        android:textColor="#1E293B"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/solis_widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Plan a small step today"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/solis_widget_action_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#9A5B00"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
