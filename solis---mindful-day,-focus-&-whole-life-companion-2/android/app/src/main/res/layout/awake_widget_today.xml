<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/solis_widget_action"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/awake_widget_surface"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@+id/solis_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AWAKE · TODAY STATS"
        android:textColor="#FF5B668B"
        android:textSize="11sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/solis_widget_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="Focus 0m · Offline 0m"
        android:textColor="#FF312B42"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/solis_widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="No tasks planned yet"
        android:textColor="#FF696579"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/solis_widget_action_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Add a task to see your plan"
        android:textColor="#FF77738A"
        android:textSize="10sp" />
</LinearLayout>
